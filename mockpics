## Quick Implementation Script

Create `generate-mock-images.js`:

```javascript
const fs = require('fs');
const path = require('path');

const categories = {
  vapes: 60,
  eliquids: 40,
  candy: 25,
  drinks: 15,
  snacks: 10
};

const colors = {
  vapes: ['FF6B6B', 'FF8E53', 'FF6B9D', 'C44569'],
  eliquids: ['4ECDC4', '44A08D', '96CEB4', '88D8B0'],
  candy: ['FFE66D', 'FF6B6B', 'FF8E53', 'F8B500'],
  drinks: ['3498DB', '2980B9', '6C5CE7', 'A29BFE'],
  snacks: ['FD79A8', 'FDCB6E', 'E17055', 'D63031']
};

// Generate image URLs
Object.entries(categories).forEach(([category, count]) => {
  console.log(`\n${category.toUpperCase()}:`);
  for (let i = 1; i <= count; i++) {
    const color = colors[category][i % colors[category].length];
    const url = `https://placehold.co/300x400/${color}/FFFFFF?text=${category}+${i}`;
    console.log(`${i}. ${url}`);
  }
});
```

